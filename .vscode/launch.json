{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "python": "${workspaceRoot}/cfxenv/bin/python",
      "preLaunchTask": "create debug env",
      "envFile": "${workspaceRoot}/.debugenv"
    },
    {
      "name": "pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "python": "${workspaceRoot}/cfxenv/bin/python",
      "preLaunchTask": "create debug env",
      "envFile": "${workspaceFolder}/.debugenv"
    }
  ]
}
